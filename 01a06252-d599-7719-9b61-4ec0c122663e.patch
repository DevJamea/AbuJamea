+ *   - expires_at    := now() + ttl
+ *   - attempts      := 0
+ *   - last_sent_at  := now()
+ *   - resend_count  := resend_count + 1
+ *   - consumed_at   := NULL   (row reusable after a consumed cycle)
+ *   - locked_until  := cleared when resend policy permits resend
